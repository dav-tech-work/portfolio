<main class="container" role="main" aria-label="Contenido principal del sitio">
  <div id="content">
    <!-- Hero principal -->
    <section class="hero-section" aria-label="Sección de bienvenida">
      <h1 class="hero-title">
        <%= (t.contact && t.contact.title) || 'Contacto Profesional' %>
      </h1>

    </section>
    <!-- Información de contacto -->
    <section class="contacto-info-section" aria-label="Información de contacto">
      <h2><%= (t.contact && t.contact.info && t.contact.info.title) || 'Información de Contacto Profesional' %></h2>

      <div class="contacto-cards">
        <div class="contacto-card">
          <div class="contacto-card-header">
            <span class="contacto-icon">📧</span>
            <h3><%= (t.contact && t.contact.info && t.contact.info.email && t.contact.info.email.title) || 'Email Profesional' %></h3>
          </div>
          <div class="contacto-card-content">
            <span id="email" class="contacto-value"></span>
            <small><%= (t.contact && t.contact.info && t.contact.info.email && t.contact.info.email.subtitle) || 'Respuesta garantizada en 24h' %></small>
          </div>
        </div>

        <div class="contacto-card">
          <div class="contacto-card-header">
            <span class="contacto-icon">📍</span>
            <h3><%= (t.contact && t.contact.info && t.contact.info.location && t.contact.info.location.title) || 'Ubicación' %></h3>
          </div>
          <div class="contacto-card-content">
            <span class="contacto-value"><%= (t.contact && t.contact.location) || 'Barcelona, España' %></span>
            <small><%= (t.contact && t.contact.info && t.contact.info.location && t.contact.info.location.subtitle) || 'Servicios remotos disponibles' %></small>
          </div>
        </div>

        <div class="contacto-card">
          <div class="contacto-card-header">
            <span class="contacto-icon">🔗</span>
            <h3><%= (t.contact && t.contact.info && t.contact.info.linkedin && t.contact.info.linkedin.title) || 'LinkedIn' %></h3>
          </div>
          <div class="contacto-card-content">
            <a href="https://www.linkedin.com/in/daniel-arribas-velazquez/" target="_blank" class="contacto-value">
              Daniel Arribas Velázquez
            </a>
            <small><%= (t.contact && t.contact.info && t.contact.info.linkedin && t.contact.info.linkedin.subtitle) || 'Perfil profesional verificado' %></small>
          </div>
        </div>

        <div class="contacto-card">
          <div class="contacto-card-header">
            <span class="contacto-icon">🐙</span>
            <h3><%= (t.contact && t.contact.info && t.contact.info.github && t.contact.info.github.title) || 'GitHub' %></h3>
          </div>
          <div class="contacto-card-content">
            <a href="https://github.com/dav-tech-work" target="_blank" class="contacto-value">
              dav-tech-work
            </a>
            <small><%= (t.contact && t.contact.info && t.contact.info.github && t.contact.info.github.subtitle) || 'Portfolio técnico público' %></small>
          </div>
        </div>
      </div>
    </section>

    <!-- Formulario de contacto -->
    <section class="formulario-section" aria-label="Formulario de contacto">
      <h2><%= (t.contact && t.contact.form && t.contact.form.title) || 'Consulta de Seguridad Enterprise' %></h2>

        <!-- Mensajes de estado -->
        <% if (typeof mensajeExito !== 'undefined' && mensajeExito) { %>
          <div class="mensaje exito">
            <span class="icono">✅</span>
            <%= mensajeExito %>
          </div>
        <% } %>

        <% if (typeof mensajeError !== 'undefined' && mensajeError) { %>
          <div class="mensaje error">
            <span class="icono">❌</span>
            <%= mensajeError %>
          </div>
        <% } %>

        <div class="formulario-container">
          <form class="formulario" id="formulario">
            <!-- Token CSRF -->
            <input type="hidden" name="csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="form-row">
              <div class="form-grupo">
                <label for="nombre"><%= (t.contact && t.contact.form && t.contact.form.name) || 'Nombre completo' %> *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="<%= (t.contact && t.contact.form && t.contact.form.name_placeholder) || 'Tu nombre completo' %>"
                  maxlength="100"
                  class="input-enterprise"
                >
              </div>

              <div class="form-grupo">
                <label for="email"><%= (t.contact && t.contact.form && t.contact.form.email) || 'Email' %> *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="<%= (t.contact && t.contact.form && t.contact.form.email_placeholder) || 'tu.email@empresa.com' %>"
                  maxlength="255"
                  class="input-enterprise"
                >
              </div>
            </div>

            <div class="form-grupo">
              <label for="asunto"><%= (t.contact && t.contact.form && t.contact.form.subject) || 'Tipo de Consulta' %> *</label>
              <select id="asunto" name="asunto" required class="input-enterprise">
                <option value=""><%= (t.contact && t.contact.form && t.contact.form.subject_placeholder) || 'Selecciona el tipo de consulta' %></option>
                <option value="<%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.auditoria) || 'Auditoría de Seguridad' %>"><%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.auditoria) || 'Auditoría de Seguridad' %></option>
                <option value="<%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.implementacion) || 'Implementación Enterprise' %>"><%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.implementacion) || 'Implementación Enterprise' %></option>
                <option value="<%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.consultoria) || 'Consultoría Técnica' %>"><%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.consultoria) || 'Consultoría Técnica' %></option>
                <option value="<%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.colaboracion) || 'Colaboración en Proyecto' %>"><%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.colaboracion) || 'Colaboración en Proyecto' %></option>
                <option value="<%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.otro) || 'Otro' %>"><%= (t.contact && t.contact.form && t.contact.form.options && t.contact.form.options.otro) || 'Otros' %></option>
              </select>
            </div>

            <div class="form-grupo">
              <label for="mensaje"><%= (t.contact && t.contact.form && t.contact.form.message) || 'Descripción del Proyecto' %> *</label>
              <textarea
                id="mensaje"
                name="mensaje"
                required
                placeholder="<%= (t.contact && t.contact.form && t.contact.form.message_placeholder) || 'Describe tu proyecto, requerimientos de seguridad, timeline, presupuesto...' %>"
                rows="6"
                maxlength="1000"
                class="input-enterprise"
              ></textarea>
              <small class="contador-caracteres">0/1000 caracteres</small>
            </div>

            <div class="form-grupo">
              <label class="checkbox-label enterprise">
                <input type="checkbox" name="privacidad" required>
                <span class="checkmark"></span>
                <p><%= (t.contact && t.contact.form && t.contact.form.privacy) || 'Acepto la ' %><a href="/privacidad" target="_blank"> <%= (t.contact && t.contact.form && t.contact.form.privacy_link) || 'política de privacidad' %></a></p> *
              </label>
            </div>

            <div class="security-note">
              <span class="security-badge">🔒</span>
              <small><%= (t.contact && t.contact.form && t.contact.form.security_note) || 'Todos los datos se transmiten de forma segura con encriptación SSL/TLS' %></small>
            </div>

            <button type="button" class="btn-enviar-enterprise" id="btn-enviar" onclick="enviarFormulario()">
              <span class="icono">🚀</span>
              <span class="btn-text"><%= (t.contact && t.contact.form && t.contact.form.submit) || 'Enviar Consulta Enterprise' %></span>
              <span class="security-badge">🛡️</span>
            </button>
          </form>
        </div>
      </section>

      <!-- Call to action profesional -->
      <section class="cta-section" aria-label="Llamada a la acción">
        <div class="cta-content">
          <h2><%= (t && t.home && t.home.cta && t.home.cta.title) || '¿Necesitas un Administrador de Sistemas con Expertise en Seguridad?' %></h2>
          <p><%= (t && t.home && t.home.cta && t.home.cta.description) || 'Especialista en seguridad enterprise con auditorías A+, infraestructura hardened y 0 incidentes de seguridad en producción.' %></p>

          <div class="cta-buttons">
            <a href="https://cv.dav-tech.work" class="btn-primary-large" target="_blank"><%= (t && t.home && t.home.cta && t.home.cta.buttons && t.home.cta.buttons.cv) || 'Ver Experiencia Completa' %></a>
            <a href="#contacto" class="btn-secondary-large"><%= (t && t.home && t.home.cta && t.home.cta.buttons && t.home.cta.buttons.contacto) || 'Consulta de Seguridad' %></a>
          </div>

          <div class="cta-links">
            <a href="https://github.com/dav-tech-work/portfolio/tree/main/docs" class="cta-link" target="_blank">
              <span class="icon">📋</span>
              <span><%= (t && t.home && t.home.cta && t.home.cta.links && t.home.cta.links.documentacion) || 'Documentación Técnica' %></span>
            </a>
            <a href="https://www.linkedin.com/in/daniel-arribas-velazquez/" class="cta-link" target="_blank">
              <span class="icon">🔗</span>
              <span><%= (t && t.home && t.home.cta && t.home.cta.links && t.home.cta.links.perfil) || 'Perfil Profesional' %></span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

<!-- Script específico para el contador de caracteres -->
<script nonce="<%= nonce %>">
  // Asegurar que el contador funcione incluso si el módulo principal falla
  document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('mensaje');
    const contador = document.querySelector('.contador-caracteres');

    if (textarea && contador) {
      // console.log('🔧 Configurando contador de caracteres...');

      // Función para actualizar el contador
      const actualizarContador = function() {
        const longitud = textarea.value.length;
        const maxLength = textarea.getAttribute('maxlength') || 1000;

        contador.textContent = `${longitud}/${maxLength} caracteres`;

        // Cambiar color según la longitud
        if (longitud > maxLength * 0.9) {
          contador.style.color = '#ef4444'; // Rojo
        } else if (longitud > maxLength * 0.8) {
          contador.style.color = '#f59e0b'; // Naranja
        } else {
          contador.style.color = 'var(--text-secondary, #b2bec3)';
        }

        // Mostrar advertencia si se acerca al límite
        if (longitud >= maxLength) {
          contador.style.fontWeight = 'bold';
        } else {
          contador.style.fontWeight = 'normal';
        }
      };

      // Configurar eventos
      textarea.addEventListener('input', actualizarContador);
      textarea.addEventListener('keyup', actualizarContador);
      textarea.addEventListener('paste', actualizarContador);
      textarea.addEventListener('cut', actualizarContador);

      // Inicializar contador
      actualizarContador();

      // console.log('✅ Contador de caracteres configurado correctamente');
    } else {
      // console.warn('⚠️ No se pudo configurar el contador de caracteres');
      // if (!textarea) console.warn('   - Textarea no encontrado');
      // if (!contador) console.warn('   - Contador no encontrado');
    }
  });
</script>

