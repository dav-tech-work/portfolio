<main class="code-container" role="main" aria-labelledby="titulo-teoria-python">
  <h1 id="titulo-teoria-python" class="page-title"><%= (t.python && t.python.theory && t.python.theory.title) || 'Teoría Python' %></h1>

  <!-- Script de debug para verificar que el JavaScript esté funcionando -->
  <script nonce="<%= nonce %>">
    console.log('🔍 [DEBUG] Página de teoría Python cargada');
    console.log('🔍 [DEBUG] Script muestra_contenido.js cargado:', typeof initMuestraContenido !== 'undefined');

    // Verificar que los elementos code existen
    document.addEventListener('DOMContentLoaded', function() {
      const codeElements = document.querySelectorAll('code[data-src]');
      console.log('🔍 [DEBUG] Elementos code encontrados:', codeElements.length);

      codeElements.forEach((element, index) => {
        console.log(`🔍 [DEBUG] Elemento ${index}:`, {
          src: element.dataset.src,
          language: element.dataset.language,
          hasContent: element.textContent.trim().length > 0
        });
      });
    });
  </script>

  <div id="content">
    <% const temas = [
      { id: "codigo_caracteristicas", archivo: "01_caracteristicas_basicas.py", clave: "basics" },
      { id: "codigo_numeros", archivo: "02_numeros.py", clave: "numbers" },
      { id: "codigo_booleanos", archivo: "03_booleanos.py", clave: "booleans" },
      { id: "codigo_strings", archivo: "04_strings.py", clave: "strings" },
      { id: "codigo_if", archivo: "06_if_elif_else.py", clave: "conditionals" },
      { id: "codigo_operadores", archivo: "07_operadores_logicos.py", clave: "logic" },
      { id: "codigo_excepciones", archivo: "08_excepciones.py", clave: "exceptions" },
      { id: "codigo_librerias", archivo: "09_libreria.py", clave: "libraries" },
      { id: "codigo_match", archivo: "10_match.py", clave: "match" },
      { id: "codigo_listas", archivo: "11_listas.py", clave: "lists" },
      { id: "codigo_bucles", archivo: "12_bucles.py", clave: "loops" },
      { id: "codigo_diccionarios", archivo: "13_diccionario.py", clave: "dicts" },
      { id: "codigo_tuplas", archivo: "14_tuplas.py", clave: "tuples" },
      { id: "codigo_set", archivo: "15_set.py", clave: "set" },
      { id: "codigo_funciones", archivo: "16_funciones.py", clave: "functions" }
    ]; %>

    <% temas.forEach(({ id, archivo, clave }) => { %>
      <details aria-label="<%= (t.python && t.python.theory && t.python.theory[clave]) || clave %>">
        <summary tabindex="0"><%= (t.python && t.python.theory && t.python.theory[clave]) || clave %></summary>
        <% if (id === "codigo_caracteristicas") { %>
          <!-- Código incluido directamente para prueba -->
          <pre><code class="language-python" id="<%= id %>">
# Características básicas de Python
print("Hola Mundo")

# Variables
numero = 1
texto = "Python"
booleano = True

# Listas
mi_lista = [1, 2, 3, 4, 5]
print(mi_lista[0])  # Primer elemento

# Diccionarios
mi_dict = {"nombre": "Python", "version": 3.9}
print(mi_dict["nombre"])

# Funciones
def saludar(nombre):
    return f"Hola {nombre}"

print(saludar("Mundo"))
          </code></pre>
        <% } else { %>
          <pre><code class="language-python" id="<%= id %>" data-src="/assets/programacion/python/teoria/conceptos_basicos/<%= archivo %>"></code></pre>
        <% } %>
      </details>
    <% }) %>

    <!-- Objetos (bloque doble) -->
    <details aria-label="<%= (t.python && t.python.theory && t.python.theory.objects) || 'Objetos Python' %>">
      <summary tabindex="0"><%= (t.python && t.python.theory && t.python.theory.objects) || 'Objetos' %></summary>
      <pre><code class="language-python" id="codigo_objetos-1" data-src="/assets/programacion/python/teoria/conceptos_basicos/clases.py"></code></pre>
      <pre><code class="language-python" id="codigo_objetos" data-src="/assets/programacion/python/teoria/conceptos_basicos/animales.py"></code></pre>
    </details>
  </div>
</main>
