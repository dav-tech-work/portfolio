<main class="code-container" role="main" aria-labelledby="titulo-teoria-js">
  <h1 id="titulo-teoria-js" class="page-title"><%= (t.js && t.js.theory && t.js.theory.subtitle) || 'Teoría JavaScript' %></h1>

  <div id="content">

    <% const temas = [
      { archivo: '01_variables.js', nombre: 'Variables' },
      { archivo: '02_condicionales.js', nombre: 'Condicionales' },
      { archivo: '03_operadores_matematicos.js', nombre: 'Operadores Matemáticos' },
      { archivo: '04_bucle.js', nombre: 'Bucles' },
      { archivo: '05_strings.js', nombre: 'Strings' },
      { archivo: '06_arrays.js', nombre: 'Arrays' },
      { archivo: '07_objetos.js', nombre: 'Objetos' },
      { archivo: '08_operadores_logicos.js', nombre: 'Operadores Lógicos' },
      { archivo: '09_arrays.js', nombre: 'Arrays Avanzado' },
      { archivo: '10_metodos_strings.js', nombre: 'Métodos Strings' },
      { archivo: '11_metodos_arrays.js', nombre: 'Métodos Arrays' },
      { archivo: '12_bucle_while.js', nombre: 'Bucle While' },
      { archivo: '13_objetos.js', nombre: 'Objetos Avanzado' },
      { archivo: '14_bucles_for.js', nombre: 'Bucles For' },
      { archivo: '15_funciones.js', nombre: 'Funciones' },
      { archivo: '16_DOM.js', nombre: 'DOM' },
      { archivo: '17_excepciones.js', nombre: 'Excepciones' },
      { archivo: '18_librerias.js', nombre: 'Librerías' },
      { archivo: '19_match.js', nombre: 'Match' },
      { archivo: 'repaso_js.js', nombre: 'Repaso' }
    ]; %>

    <% temas.forEach(({ archivo, nombre }) => { %>
      <details aria-label="<%= nombre %>">
        <summary tabindex="0"><%= nombre %></summary>
        <pre><code class="language-javascript" data-src="/assets/programacion/javascript/teoria/<%= archivo %>"></code></pre>
      </details>
    <% }) %>

  </div>
</main>
