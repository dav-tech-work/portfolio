<main class="container">
    <section class="topic-section php-content">
        <h1 class="page-title"><%= (t.education && t.education.php_sql && t.education.php_sql.practices && t.education.php_sql.practices.title) || 'Prácticas PHP/SQL' %></h1>
        <div class="topic-content-container php-layout">
            <h2 class="topic-title"> <%= (t.education && t.education.php_sql && t.education.php_sql.sql && t.education.php_sql.sql.title) || 'SQL' %></h2>
            <div class="topic-content">
                <div class="topic-item">
                    <div id="content">
                        <% const temas = [
                          { id: "Conceptos_Basicos", archivo: "Conceptos_Basicos.sql", clave: "Conceptos Básicos" },
                          { id: "Renting_Cars", archivo: "renting_cars.sql", clave: "Renting Cars" },
                          { id: "enunciados", archivo: "renting_cars_enunciados.sql", clave: "Enunciados Renting Cars" },
                          { id: "biblioteca", archivo: "biblioteca.sql", clave: "Base de Datos Biblioteca" },
                          { id: "colores", archivo: "colores.sql", clave: "Gestor de Colores" },
                          { id: "gestor_tareas", archivo: "gestor_tareas.sql", clave: "Gestor de Tareas" },
                          { id: "repaso", archivo: "repaso.sql", clave: "Ejercicios de Repaso" },
                          { id: "ejercicio_1_db", archivo: "ejecicio_1_db.sql", clave: "Ejercicio 1 - Base de Datos" }
                        ]; %>

                        <% temas.forEach(({ id, archivo, clave }) => { %>
                          <details aria-label="<%= clave %>">
                            <summary tabindex="0"><%= clave %></summary>
                            <pre><code class="language-sql" id="<%= id %>" data-src="/assets/programacion/web/php_sql/<%= archivo %>"></code></pre>
                          </details>
                        <% }) %>
                    </div>
                </div>
            </section>            <h2 class="topic-title"><%= (t.education && t.education.php_sql && t.education.php_sql.php && t.education.php_sql.php.title) || 'PHP' %></h2>
            <div class="topic-content">
                <div class="topic-item">
                    <h3 class="topic-title-1"><%= (t.education && t.education.practice && t.education.practice['01']) || 'Práctica 1' %></h3>
                    <ul>
                        <li><a href="/assets/programacion/web/php_sql/colores/index" class="topic-link" target="_blank">Colores</a></li>
                    </ul>
                    <h3 class="topic-title-1"><%= (t.education && t.education.practice && t.education.practice['02']) || 'Práctica 2' %></h3>
                    <ul>
                        <li><a href="/assets/programacion/web/php_sql/gestor_tareas/index" class="topic-link" target="_blank">Gestor de Tareas</a></li>
                    </ul>
                </div>
            </section>
        </div>
    </section>
</main>
