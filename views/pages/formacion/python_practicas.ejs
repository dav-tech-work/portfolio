    <% practicas.forEach(({ archivo, nombre }) => { %>
      <details>
        <summary><%= archivo %></summary>
        <pre><code class="language-python" data-src="/assets/programacion/python/practicas/ejecicios/<%= archivo %>"></code></pre>
      </details>
    <% }); %>
  </div>
</main>
