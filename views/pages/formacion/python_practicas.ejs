      { archivo: '05_practica_v1.py', nombre: 'practica6' },
      { archivo: '05_practica_v2.py', nombre: 'practica7' },
      { archivo: '06_practica.py', nombre: 'practica8' },
      { archivo: '06_practica_ferran.py', nombre: 'practica9' },
      { archivo: '07_practicat.py', nombre: 'practica10' },
      { archivo: '08_practica.py', nombre: 'practica11' },
      { archivo: '09_practica.py', nombre: 'practica12' },
      { archivo: '10_practica.py', nombre: 'practica13' },
      { archivo: '11_practica.py', nombre: 'practica14' },
      { archivo: '12_practica.py', nombre: 'practica15' },
