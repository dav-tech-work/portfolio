<main class="code-container" role="main" aria-labelledby="titulo-practicas-js">
  <h1 id="titulo-practicas-js" class="page-title"><%= (t.js && t.js.practices && t.js.practices.subtitle) || 'Prácticas JavaScript' %></h1>

  <div id="content">
    <%
    const practicas = [
      { archivo: '01_practica.js', nombre: 'Práctica 1' },
      { archivo: '02_practica.js', nombre: 'Práctica 2' },
      { archivo: 'anagramas.js', nombre: 'Anagramas' },
      { archivo: 'calculadora.js', nombre: 'Calculadora' },
      { archivo: 'palindromos.js', nombre: 'Palíndromos' },
      { archivo: 'traductor_de_dias.js', nombre: 'Traductor de Días' },
      { archivo: 'random.js', nombre: 'Números Aleatorios' },
      { archivo: 'ej_saludo.js', nombre: 'Ejemplo Saludo' },
      { archivo: 'ej_numero_primo.js', nombre: 'Números Primos' },
      { archivo: 'dias_semana.js', nombre: 'Días de la Semana' },
      { archivo: 'primer_javascript.js', nombre: 'Primer JavaScript' }
    ];
    %>

    <% practicas.forEach(({ archivo, nombre }) => { %>
      <details aria-label="<%= nombre %>">
        <summary tabindex="0"><%= nombre %></summary>
        <pre><code class="language-javascript" data-src="/assets/programacion/javascript/practicas/<%= archivo %>"></code></pre>
      </details>
    <% }) %>
  </div>
</main>
