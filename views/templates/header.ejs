<header>
  <nav role="navigation" aria-label="Navegación principal">
    <div class="nav-container">

      <div class="nav-left">
        <!-- Logo accesible -->
        <a href="/" class="logo-link" aria-label="Inicio">
          <img src="/assets/img/dav_logo_editado.svg"
               alt="Logo DAV"
               class="logo-img"
               width="120"
               height="40"
               decoding="async" />
        </a>

        <!-- Botón de menú para móviles -->
        <button class="menu-toggle" aria-label="Abrir o cerrar el menú de navegación">
          <i class="fas fa-bars" aria-hidden="true"></i>
        </button>

        <!-- Menú principal -->
        <ul class="menu-items">
          <li>
            <a href="/?lang=<%= typeof idioma !== 'undefined' ? idioma : 'es' %>" data-i18n="nav.home">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.home ? t.navigation.home : 'Inicio' %>
            </a>
          </li>
          <li>
            <a href="/?lang=<%= typeof idioma !== 'undefined' ? idioma : 'es' %>#about" data-i18n="nav.about">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.about ? t.navigation.about : 'Sobre Mí' %>
            </a>
          </li>
          <li>
            <a href="/?lang=<%= typeof idioma !== 'undefined' ? idioma : 'es' %>#formacion" data-i18n="nav.education">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.education ? t.navigation.education : 'Formación' %>
            </a>
          </li>
          <li>
            <a href="/?lang=<%= typeof idioma !== 'undefined' ? idioma : 'es' %>#proyectos" data-i18n="nav.projects">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.projects ? t.navigation.projects : 'Proyectos' %>
            </a>
          </li>
          <li>
            <a href="/?lang=<%= typeof idioma !== 'undefined' ? idioma : 'es' %>#homelab" data-i18n="nav.homelab">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.homelab ? t.navigation.homelab : 'Homelab' %>
            </a>
          </li>
          <li>
            <a href="/?lang=<%= typeof idioma !== 'undefined' ? idioma : 'es' %>#contacto" data-i18n="nav.contact">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.contact ? t.navigation.contact : 'Contacto' %>
            </a>
          </li>
          <!-- <li>
            <a href="/curriculum" data-i18n="nav.cv">
              <%= typeof t !== 'undefined' && t.navigation && t.navigation.cv ? t.navigation.cv : 'Currículum' %>
            </a>
          </li> -->

        </ul>
      </div>

      <div class="nav-right">
        <!-- Búsqueda -->
        <div class="cv-download">
          <a href="<% if (idioma === 'es') { %>
            https://cv.dav-tech.work/download/cv.pdf?lang=es
          <% } else if (idioma === 'en') { %>
            https://cv.dav-tech.work/download/cv.pdf?lang=en
          <% } else { %>
            https://cv.dav-tech.work/download/cv.pdf?lang=ca
          <% } %>"
             class="cv-download-btn"
             target="_blank"
             rel="noopener noreferrer"
             aria-label="<%= (t && t.cv && t.cv.download) ? t.cv.download : 'Descargar currículum en PDF' %>">
            <i class="fas fa-download" aria-hidden="true"></i>
            <%= (t && t.cv && t.cv.download) ? t.cv.download : 'Descargar CV' %>

          </a>
        </div>
        <div class="search-container">
          <button class="search-toggle" aria-label="Abrir campo de búsqueda">
            <i class="fas fa-search" aria-hidden="true"></i>
          </button>
          <div class="search-dropdown" role="search">
            <!-- Campo de entrada con ID esperado por search.js -->
            <input type="text" id="searchInput" placeholder="Buscar..." aria-label="Campo de búsqueda" />

            <button class="close-search" aria-label="Cerrar búsqueda">
              <i class="fas fa-times" aria-hidden="true"></i>
            </button>

            <!-- Resultados con ID esperado por search.js -->
            <div class="search-results" id="searchResults" aria-live="polite"></div>
          </div>
        </div>


        <!-- Cambiar tema -->
        <button class="theme-toggle" aria-label="Cambiar tema (oscuro o claro)">
          <i class="fas fa-moon" aria-hidden="true"></i>
        </button>

        <!-- Selector de idioma -->
        <label for="languageSelect" class="sr-only"></label>
        <select id="languageSelect" aria-label="Idioma">
          <option value="es" <%= typeof idioma !== 'undefined' && idioma === 'es' ? 'selected' : '' %>>ES</option>
          <option value="en" <%= typeof idioma !== 'undefined' && idioma === 'en' ? 'selected' : '' %>>EN</option>
          <option value="cat" <%= typeof idioma !== 'undefined' && idioma === 'cat' ? 'selected' : '' %>>CAT</option>
        </select>
      </div>

    </div>
  </nav>
</header>
