{
  "name": "estructura_base",
  "version": "2.0.0",
  "description": "Estructura base web Segura - Optimizada para Rendimiento y Seguridad",
  "main": "app.mjs",
  "type": "module",
  "scripts": {
    "start": "node app.mjs",
    "start:prod": "cross-env NODE_ENV=production node app.mjs",
    "dev": "cross-env NODE_ENV=development node --watch app.mjs",
    "mantenimiento-completo": "node scripts/MANTENIMIENTO/maintenance-complete.mjs",
    "mantenimiento": "node scripts/MANTENIMIENTO/maintenance-quick.mjs",
    "responsive-completo": "node \"scripts/Diseño&CSS/responsive-complete.mjs\"",
    "responsive": "node \"scripts/Diseño&CSS/responsive-quick.mjs\"",
    "verificacion-completo": "node scripts/Verificacion/verify-complete.mjs",
    "verificacion": "node scripts/Verificacion/verify-quick.mjs",
    "testing-completo": "node scripts/Testing/testing-complete.mjs",
    "testing": "node scripts/Testing/testing-quick.mjs",
    "analisis-completo": "node scripts/Analisis/analysis-complete.mjs",
    "analisis": "node scripts/Analisis/analysis-quick.mjs",
    "rendimiento-completo": "node scripts/Rendimiento/performance-complete.mjs",
    "rendimiento": "node scripts/Rendimiento/performance-quick.mjs",
    "seguridad-completo": "node scripts/Seguridad/security-complete.mjs",
    "seguridad": "node scripts/Seguridad/security-quick.mjs",
    "ssl-cloudflare-completo": "node scripts/Red/ssl-cloudflare-complete.mjs",
    "ssl-cloudflare": "node scripts/Red/ssl-cloudflare-quick.mjs",
    "monitoreo-completo": "node \"scripts/Monitoreo&Salud/monitoring-complete.mjs\"",
    "monitoreo": "node \"scripts/Monitoreo&Salud/monitoring-quick.mjs\"",
    "utilidades-completo": "node \"scripts/Utilidades/utilities-complete.mjs\"",
    "utilidades": "node \"scripts/Utilidades/utilities-quick.mjs\"",
    "optimizacion-completo": "node scripts/Optimizacion/optimizacion-complete.mjs",
    "chequeo-resultados-dirs": "node scripts/check-results-dirs.mjs",
    "test": "mocha test/**/*.test.mjs --timeout 15000 --exit",
    "test:config": "node test/test-config.js",
    "test:unit": "mocha test/unit/**/*.test.mjs --timeout 10000 --exit",
    "test:integration": "mocha test/integration/**/*.test.mjs --timeout 15000 --exit",
    "test:performance": "mocha test/performance/**/*.test.mjs --timeout 60000 --exit",
    "test:security": "mocha test/security/**/*.test.mjs --timeout 20000 --exit",
    "test:e2e": "mocha test/e2e/**/*.test.mjs --timeout 30000 --exit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:performance && npm run test:e2e && npm run test:config",
    "test:coverage": "nyc npm run test",
    "lint": "eslint src/ app.mjs",
    "lint:fix": "eslint src/ app.mjs --fix",
    "format": "prettier --write src/ app.mjs",
    "format:check": "prettier --check src/ app.mjs",
    "workflow:security": "npm run seguridad-completo",
    "workflow:testing": "npm run testing-completo",
    "workflow:performance": "npm run rendimiento-completo",
    "workflow:monitoring": "npm run monitoreo-completo",
    "workflow:code-quality": "npm run analisis-completo",
    "workflow:all": "npm run workflow:security && npm run workflow:testing && npm run workflow:performance && npm run workflow:monitoring && npm run workflow:code-quality",
    "workflow:verify": "npm run verificacion-completo",
    "contacto:check": "node scripts/Verificacion/contacto-check.mjs",
    "contacto:test": "node scripts/Testing/contacto-test.mjs",
    "hamburger:debug": "node scripts/Verificacion/hamburger-debug.mjs",
    "minify-assets": "node scripts/Utilidades/minify-assets.mjs",
    "hamburger:force": "node scripts/Utilidades/force-hamburger.mjs force",
    "hamburger:restore": "node scripts/Utilidades/force-hamburger.mjs restore"
  },
  "keywords": [
    "Node.js",
    "Express",
    "EJS",
    "Security",
    "Authentication",
    "Validation",
    "Performance",
    "Optimization",
    "Web Application",
    "Secure",
    "Rate Limiting",
    "CSRF Protection",
    "XSS Protection"
  ],
  "author": {
    "name": "Daniel Arribas Velazquez",
    "email":"danielarribasvelazquez@dav-tech.work"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dav-tech-work/porfolio.git"
  },
  "bugs": {
    "url": "https://github.com/dav-tech-work/porfolio/issues"
  },
  "homepage": "https://github.com/dav-tech-work/porfolio#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.2.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "html-entities": "^2.6.0",
    "ioredis": "^5.6.1",
    "isomorphic-dompurify": "^2.26.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "redis": "^5.6.0",
    "session-file-store": "^1.5.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "chai": "^4.4.1",
    "clean-css-cli": "^5.6.3",
    "cross-env": "^7.0.3",
    "cssnano": "^7.1.0",
    "html-minifier-terser": "^7.2.0",
    "eslint": "^9.0.0",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "nyc": "^15.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.7",
    "supertest": "^7.0.0",
    "terser": "^5.31.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "nyc": {
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "exclude": [
      "test/**",
      "coverage/**",
      "node_modules/**",
      "scripts/**"
    ],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true,
      "mocha": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  },
  "config": {
    "port": 3000,
    "test_port": 3001
  },
  "files": [
    "app.mjs",
    "src/",
    "views/",
    "public/",
    "config.env.example",
    "README.md",
    "README_SECURITY.md"
  ],
  "nodemonConfig": {
    "watch": [
      "src/",
      "views/",
      "app.mjs",
      "config.env"
    ],
    "ext": "mjs,js,ejs,json",
    "ignore": [
      "test/",
      "logs/",
      "coverage/",
      "node_modules/"
    ],
    "delay": 1000
  },
  "_moduleAliases": {
    "@": "./src",
    "@config": "./src/config",
    "@middleware": "./src/middleware",
    "@routes": "./src/routes",
    "@utils": "./src/utils",
    "@services": "./src/utils/servicios",
    "@security": "./src/utils/seguridad",
    "@validation": "./src/utils/validation"
  }
}
